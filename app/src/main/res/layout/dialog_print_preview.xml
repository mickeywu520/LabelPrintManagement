<!-- 檔案: app/src/main/res/layout/dialog_print_preview.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/border">

        <!-- 料號 -->
        <TextView
            android:id="@+id/preview_tvPartNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp"
            android:text="料號: 3717602360105P" />

        <!-- 品名 -->
        <TextView
            android:id="@+id/preview_tvPartName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="8dp"
            android:text="品名: FPC-7602 BOTTOM COVER BRACKET" />

        <!-- 數量 -->
        <TextView
            android:id="@+id/preview_tvQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp"
            android:text="數量: 1000 PCS" />

        <!-- D/C -->
        <TextView
            android:id="@+id/preview_tvDC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp"
            android:text="D/C: 250601" />

        <!-- HW Ver -->
        <TextView
            android:id="@+id/preview_tvHwVer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp"
            android:text="H/W Ver: V1.01" />

        <!-- FW Ver -->
        <TextView
            android:id="@+id/preview_tvFwVer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="8dp"
            android:text="F/W Ver: V1.6F" />

        <!-- Arbor Logo (optional, based on final design) -->
        <ImageView
            android:id="@+id/preview_ivArborLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arbor_logo_placeholder"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:contentDescription="Arbor Logo" />

    </LinearLayout>
</LinearLayout>
